{
  "name": "btms-core",
  "version": "0.2.26",
  "description": "Tools for creating and managing UTXO-based tokens",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "start": "npm run lars",
    "lars": "npx @bsv/lars",
    "backend": "cd backend && npm run start",
    "frontend": "cd frontend && npm run dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "doc": "ts2md",
    "lint": "ts-standard --fix .",
    "prettier": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p2ppsr/btms-core.git"
  },
  "keywords": [
    "Bitcoin",
    "BSV",
    "UTXO",
    "token"
  ],
  "author": "Peer-to-peer Privacy Systems Research LLC",
  "license": "Open BSV License",
  "bugs": {
    "url": "https://github.com/p2ppsr/btms-core/issues"
  },
  "homepage": "https://github.com/p2ppsr/btms-core#readme",
  "devDependencies": {
    "@bsv/lars": "^1.5.7",
    "@types/bn.js": "^5.1.1",
    "@types/jest": "^29.4.0",
    "@types/node": "^18.7.4",
    "@typescript-eslint/eslint-plugin": "^5.52.0",
    "@typescript-eslint/parser": "^5.52.0",
    "eslint": "^8.34.0",
    "jest": "^29.4.3",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "ts-standard": "^12.0.2",
    "typescript": "^4.9.5",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17"
  },
  "dependencies": {
    "@bsv/message-box-client": "^1.4.5",
    "@bsv/overlay": "^0.5.2",
    "@bsv/sdk": "^1.8.13",
    "json-stable-stringify": "^1.3.0",
    "mongodb": "^7.0.0",
    "prettier": "^3.6.2",
    "react-qr-code": "^2.0.18",
    "ts2md": "^0.2.4",
    "express": "^4.19.2",
    "cors": "^2.8.5"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
