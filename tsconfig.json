{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",

    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true
  },

  "include": ["backend/src/**/*.ts", "src/**/*.ts", "test.ts"],

  "exclude": ["node_modules", "frontend", "dist", "jest.config.ts"]
}
